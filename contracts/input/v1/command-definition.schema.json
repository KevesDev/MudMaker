{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mudmaker.local/schemas/command-definition.v1.json",
  "title": "MudMaker Host-Published CommandDefinition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "revision",
    "key",
    "aliases",
    "scope",
    "availability",
    "args",
    "handler",
    "rateClass",
    "help",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "mudmaker.command.v1"
    },
    "status": {
      "const": "host-published-asset"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 24,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96
      }
    },
    "scope": {
      "enum": [
        "SystemProtected",
        "Session",
        "Account",
        "Character",
        "Equipment",
        "Inventory",
        "Location",
        "NearbyObjects",
        "Exits",
        "Channels"
      ]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entityAssetId": {
          "type": "string",
          "format": "uuid"
        },
        "regionAssetId": {
          "type": "string",
          "format": "uuid"
        },
        "questAssetId": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "priority": {
      "type": "integer",
      "minimum": -100,
      "maximum": 100
    },
    "merge": {
      "enum": [
        "Union",
        "ReplaceScoped",
        "Intersect",
        "RemoveScoped"
      ]
    },
    "availability": {
      "$ref": "#/$defs/rule"
    },
    "args": {
      "$ref": "#/$defs/args"
    },
    "handler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "nativeActionId"
      ],
      "properties": {
        "kind": {
          "enum": [
            "nativeAction",
            "graphBinding",
            "scriptBinding"
          ]
        },
        "nativeActionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "bindingAssetId": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "rateClass": {
      "enum": [
        "navigation",
        "interaction",
        "chat",
        "rp_post",
        "profile_edit",
        "search"
      ]
    },
    "help": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "summary",
        "usage"
      ],
      "properties": {
        "category": {
          "type": "string",
          "maxLength": 64
        },
        "summary": {
          "type": "string",
          "maxLength": 400
        },
        "usage": {
          "type": "string",
          "maxLength": 300
        },
        "examples": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "protected": {
      "type": "boolean"
    },
    "visibleToPlayer": {
      "type": "boolean"
    },
    "declaredOverrideId": {
      "type": "string",
      "format": "uuid"
    }
  },
  "$defs": {
    "rule": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "op",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "always"
            },
            "value": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "rules"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "enum": [
                "all",
                "any"
              ]
            },
            "rules": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/rule"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "rule"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "not"
            },
            "rule": {
              "$ref": "#/$defs/rule"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "enum": [
                "roleAtLeast",
                "isActor",
                "owns",
                "hasComponent",
                "hasItem",
                "currentRoom",
                "withinRegion",
                "exitTraversable",
                "questState",
                "levelRange",
                "worldFlagEquals",
                "channelMember",
                "cooldownReady"
              ]
            },
            "value": {
              "type": [
                "string",
                "integer",
                "boolean"
              ]
            }
          }
        }
      ]
    },
    "arg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "type": {
          "enum": [
            "word",
            "quotedText",
            "text",
            "integer",
            "decimal",
            "boolean",
            "enum",
            "entitySelector",
            "inventoryItemSelector",
            "visibleCharacterSelector"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "maxUtf8Bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 49152
        },
        "choices": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "allowNewlines": {
          "type": "boolean"
        },
        "maxLines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 800
        }
      }
    },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style"
      ],
      "properties": {
        "style": {
          "enum": [
            "none",
            "restText",
            "positional",
            "named",
            "split"
          ]
        },
        "parameters": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/arg"
          }
        },
        "left": {
          "$ref": "#/$defs/arg"
        },
        "right": {
          "$ref": "#/$defs/arg"
        },
        "switches": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 24,
          "items": {
            "type": "string",
            "maxLength": 64
          }
        },
        "allowNewlines": {
          "type": "boolean"
        },
        "maxUtf8Bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 49152
        },
        "maxLines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 800
        },
        "freeTextMode": {
          "enum": [
            "singleLine",
            "multiline"
          ]
        }
      }
    }
  }
}
