{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mudmaker.local/contracts/ui/v1/ui-control.schema.json",
  "title": "MudMaker UI control catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "workspace",
    "status",
    "controls"
  ],
  "properties": {
    "schema": {
      "const": "mudmaker.ui-controls.v1"
    },
    "workspace": {
      "enum": [
        "home",
        "editor",
        "client",
        "host"
      ]
    },
    "status": {
      "const": "DESIGN_NOT_IMPLEMENTED"
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "workspace",
          "surface",
          "kind",
          "label",
          "tooltip",
          "actionId",
          "stateOwner",
          "permission",
          "visibleWhen",
          "enabledWhen",
          "stateVariants",
          "keyboard",
          "testId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(home|editor|client|host)\\.[a-z]+\\.[0-9]{2}$"
          },
          "workspace": {
            "enum": [
              "home",
              "editor",
              "client",
              "host"
            ]
          },
          "surface": {
            "type": "string",
            "minLength": 5
          },
          "kind": {
            "enum": [
              "button",
              "view",
              "status",
              "text",
              "input",
              "textarea",
              "dropdown",
              "toggle",
              "slider",
              "panel",
              "tab",
              "tree",
              "list"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "tooltip": {
            "type": "string",
            "minLength": 10
          },
          "actionId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^ui\\.[a-zA-Z0-9.]+$"
          },
          "stateOwner": {
            "enum": [
              "HomeState",
              "EditorState",
              "ClientState",
              "HostAdminState"
            ]
          },
          "permission": {
            "type": "string",
            "minLength": 1
          },
          "visibleWhen": {
            "type": "string",
            "minLength": 1
          },
          "enabledWhen": {
            "type": "string",
            "minLength": 1
          },
          "stateVariants": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "keyboard": {
            "type": "string",
            "minLength": 1
          },
          "testId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
